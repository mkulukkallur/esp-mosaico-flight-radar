menu "Flight Radar"

    config FR_WIFI_SSID
        string "Fallback Wi-Fi network name (SSID)"
        default ""
        help
            Normally leave empty: the radar uses the Wi-Fi network saved in the
            Mosaico's Vibe Mode settings. Set this only to override it.

    config FR_WIFI_PASSWORD
        string "Fallback Wi-Fi password"
        default ""

    config FR_MANUAL_LAT
        string "Manual latitude (leave empty to detect automatically)"
        default ""
        help
            Decimal degrees, e.g. 40.7128. Leave both manual fields empty and the
            radar works out its location at every start-up: nearby Wi-Fi networks
            (beaconDB) first, then the internet address (ipinfo.io).

    config FR_MANUAL_LON
        string "Manual longitude (west is negative; leave empty to detect)"
        default ""

    config FR_WIFI_GEO_URL
        string "Wi-Fi geolocation service URL"
        default "https://api.beacondb.net/v1/geolocate"

    config FR_IP_GEO_URL
        string "IP geolocation service URL"
        default "https://ipinfo.io/json"

    config FR_REVGEO_URL
        string "Town-name lookup (reverse geocoding) URL"
        default "https://nominatim.openstreetmap.org/reverse"
        help
            OpenStreetMap Nominatim; one request per start-up. Usage policy:
            https://operations.osmfoundation.org/policies/nominatim/

    config FR_API_BASE
        string "ADS-B API base URL"
        default "https://opendata.adsb.fi/api/v3"
        help
            Any ADSBexchange-v2-compatible API with a /lat/X/lon/Y/dist/NM endpoint.
            adsb.fi (default) is free for personal, non-commercial use, max 1 request/second.
            Alternative: https://api.adsb.lol/v2

    config FR_REFRESH_SEC
        int "Seconds between data refreshes"
        range 5 120
        default 10

    choice FR_UNITS
        prompt "Distance units"
        default FR_UNITS_IMPERIAL

        config FR_UNITS_IMPERIAL
            bool "Miles (ranges 2/5/10/25 mi)"
        config FR_UNITS_METRIC
            bool "Kilometres (ranges 3/8/15/40 km)"
    endchoice

    config FR_TIMEZONE
        string "POSIX timezone for the clock"
        default "EST5EDT,M3.2.0,M11.1.0"

endmenu
